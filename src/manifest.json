{
  "manifest_version": 3,
  "name": "Work for Gmail",
  "description": "See who you’re emailing in Work, and add them in one click.",
  "version": "0.1.0",
  "key": "",
  "action": { "default_title": "Work" },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "permissions": ["sidePanel"],
  "host_permissions": ["https://mail.google.com/*", "https://work.betterthangood.xyz/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["person.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
